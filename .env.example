# Jira Cloud bot identity. Use an API token, never your Atlassian password.
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=agent-bot@your-company.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=ENG

# The repository this agent may index and use for bounded work.
# Set either CORE_REPOSITORY_PATH for a local checkout or CORE_REPOSITORY_URL for
# an explicit, read-only clone used only by `--index-repository`.
CORE_REPOSITORY_URL=https://github.com/your-org/your-core-repository.git

# Local persistent state. Keep this outside the cloned repository if preferred.
AGENT_DATABASE_PATH=.runtime/agent.db
KNOWLEDGE_BASE_PATH=.runtime/knowledge.db
